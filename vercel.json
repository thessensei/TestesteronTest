{
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/forum-stats",
      "destination": "/api/forum?stats=1"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/seo?type=rss"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?type=rss"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/blog",
      "destination": "/api/seo?type=blog"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/api/seo?type=blog&slug=$1"
    },
    {
      "source": "/forum/t/(.*)",
      "destination": "/api/seo?type=thread&id=$1"
    }
  ],
  "redirects": [
    {
      "source": "/forum",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/forum/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/forum/index.html",
      "destination": "/blog/",
      "permanent": true
    }
  ]
}
