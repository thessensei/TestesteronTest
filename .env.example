# Yerel kullanım: .env.local dosyasına kopyalayın; gerçek değerleri Git'e eklemeyin.
# Canlı kullanım: aynı değişkenleri dağıtım platformunun gizli ortam ayarlarına girin.
DATABASE_URL=
ADMIN_USERNAME=admin
# En az 16 karakterlik benzersiz parola
ADMIN_PASSWORD=
# En az 32 karakterlik rastgele imza anahtarı
SESSION_SECRET=
# Canlı site kökü; ör. https://site-adresiniz (sonuna yol eklemeyin)
SITE_URL=

# Forum için Google ile Giriş / Kayıt Ol (OAuth 2.0 Web İstemcisi; isteğe bağlı)
# Google Cloud Console yetkili yönlendirme adresi: https://site-adresiniz/api/forum-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Konu üretimi için aşağıdakilerden yalnızca kullandığınızı doldurun.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MOONSHOT_API_KEY=
KIMI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Ek ağ çevirisini kapatmak için 0. AI sağlayıcısı kullanımı bundan bağımsızdır.
ENABLE_MACHINE_TRANSLATION=0
# İsteğe bağlı paylaşım; ikisi de dolu olmadığında paylaşım atlanır.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
